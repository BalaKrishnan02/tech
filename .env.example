# Application Environment Configuration
APP_NAME="AI-Powered Digital Twin Framework for Land Use Change in Disaster-Affected Regions"
APP_ENV=development
DEBUG=True

# Server settings
HOST=0.0.0.0
PORT=8000
FRONTEND_PORT=5173

# Database configuration
# SQLite default for local development fallback:
DATABASE_URL=sqlite:///./data/digital_twin.db
# PostgreSQL + PostGIS (production-ready):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/digital_twin_gis

# Storage Paths
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
SAMPLES_DIR=./data/samples
MODELS_DIR=./models

# External Real Data Providers (Optional - transparently falls back to calibrated observational telemetry when empty)
NASA_EARTHDATA_TOKEN=
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
IMD_API_KEY=
CHENNAI_FLOOD_MONITOR_API_KEY=
ISRO_BHUVAN_TOKEN=

# LLM Providers (Optional - transparently falls back to evidence-grounded DB expert system when empty)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=offline_grounded

# Voice Bot Configuration
TAMIL_VOICE_RATE=1.0
TTS_PROVIDER=gtts_fallback # or browser_speech
